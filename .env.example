# ── Public site ────────────────────────────────────────────────────────────
# Canonical URL, used for metadata, sitemap and e-mail links.
NEXT_PUBLIC_SITE_URL=https://www.example.nl

# ── Admin login (one account, no database) ─────────────────────────────────
# Create both values with: npm run admin:wachtwoord
ADMIN_USERNAME=yassine128
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# ── Storage of admin changes (GitHub) ──────────────────────────────────────
# Fine-grained token with "Contents: Read and write" on this repository only.
# Locally (without a token) changes are written to this checkout instead.
GITHUB_CONTENT_TOKEN=
# Optional, defaults shown.
GITHUB_REPO=raketkroket/DSM
GITHUB_BRANCH=main

# ── E-mail for the forms (Resend, free plan) ──────────────────────────────
RESEND_API_KEY=
# Optional. Without a verified domain leave it empty: mail is then sent from onboarding@resend.dev,
# which only reaches the address of the Resend account (fine for notifications to the owner).
RESEND_FROM_EMAIL=
# Recipient of new enquiries, unless set in the admin (Instellingen → Meldingen).
ENQUIRY_NOTIFICATION_EMAIL=

# ── Optional: Upstash Redis (free, Vercel Marketplace) ─────────────────────
# Shares login and form rate limits across servers. Vercel fills these in automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=
