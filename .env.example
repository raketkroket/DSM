# ── Public site ────────────────────────────────────────────────────────────
# Canonical URL, used for metadata, sitemap, e-mail links and password recovery.
NEXT_PUBLIC_SITE_URL=https://www.example.nl

# ── Supabase (Project settings → API) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used exclusively by /api/offerte and /api/contact to store enquiries.
# Never expose this key to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Long random string. Vercel Cron sends it to /api/keepalive once a day so a free Supabase
# project never pauses for inactivity. Generate one with: openssl rand -hex 32
CRON_SECRET=

# Optional: salt for hashing visitor IP addresses (rate limiting). Defaults to the service key.
ENQUIRY_HASH_SALT=

# ── E-mail (Resend) ────────────────────────────────────────────────────────
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g. "Dedicated Security Management <website@example.nl>"
RESEND_FROM_EMAIL=
# Fallback recipient for new enquiries. The admin setting "E-mailadres voor nieuwe aanvragen" takes precedence.
ENQUIRY_NOTIFICATION_EMAIL=
